{
    "go.buildTags": "conformance",
    "go.testTags": "conformance",

    "jest.rootPath": "conformance/typescript",
    "jest.jestCommandLine": "node --experimental-vm-modules node_modules/.bin/jest",

    "python.defaultInterpreterPath": "${workspaceFolder}/conformance/python/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "conformance/python"
    ]
}
